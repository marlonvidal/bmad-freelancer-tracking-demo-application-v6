# Test Environment Configuration
# Copy to .env.test and fill in values for your environment

# Application
TEST_ENV=local
BASE_URL=http://localhost:5173
API_URL=http://localhost:5173

# Pact Broker (required for contract testing)
PACT_BROKER_BASE_URL=https://your-pactflow-instance.pactflow.io
PACT_BROKER_TOKEN=your-pactflow-token

# Test User Credentials (if auth is added)
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD=your-test-password
